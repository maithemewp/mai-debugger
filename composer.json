{
  "require": {
    "php": "^8.1",
    "filp/whoops": "^2.18",
    "symfony/var-dumper": "^6.4",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/bizbudding/deployable-guard"
    }
  ],
  "require-dev": {
    "bizbudding/deployable-guard": "^1"
  },
  "scripts": {
    "install-git-hooks": [
      "sh -c 'test -f vendor/bin/deployable-guard && php vendor/bin/deployable-guard install-hook || true'"
    ],
    "post-install-cmd": [
      "@install-git-hooks"
    ],
    "post-update-cmd": [
      "@install-git-hooks"
    ]
  }
}
